// Cloudflare hosting for asrnaam.com.
// Serves the repository exactly as GitHub Pages does: same files, same URLs.
// Folder pages keep their trailing slash (/names/ayra/), and unknown paths
// return 404.html with a real 404 status.
{
  "name": "asrnaam",
  "compatibility_date": "2026-11-22",
  // Branch previews (Workers Builds runs `wrangler preview` on non-main branches; workers.dev previews are noindex)
  "previews": {},
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
